{
  "name": "@leighmcculloch/hub",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys src/main.ts",
    "check": "deno check src/main.ts tests/*.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "desktop": "deno desktop src/desktop.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "tests/",
      "deno.json"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "include": [
      "src/",
      "tests/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@std/encoding": "jsr:@std/encoding@^1.0.6",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@xterm/xterm": "npm:@xterm/xterm@^5.5.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false
  },
  "desktop": {
    "app": {
      "name": "hub",
      "identifier": "dev.hub.app"
    },
    "backend": "webview"
  }
}
